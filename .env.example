# JTEST WEB LITE — fully web-based, no JUNE_SESSIONS, no dev dashboard
PORT=3000
PLATFORM_MAX_BOTS=100
PLATFORM_SLOT_TTL_MIN=15
PLATFORM_CREATES_PER_HOUR=10
PLATFORM_MAX_WS_CONNECTIONS=200
PLATFORM_MAX_WS_PER_IP=20
LOG_LEVEL=fatal

# ── Storage ──────────────────────────────────────────────────────────────
# There is no database engine. Each bot owns one JSON file:
#   <JUNE_DATA_DIR>/<botId>.json
# Back up by copying the directory. See "Data Storage" in README.md.
# JUNE_DATA_DIR=/path/to/data/bots

# Write debounce per bot, in milliseconds. Writes are atomic (temp + rename),
# so raising this only delays persistence, it does not risk partial files.
# Raise it on slow disks; the exit handler flushes regardless.
# JUNE_DB_FLUSH_MS=250

# ── Commands ─────────────────────────────────────────────────────────────
# Commands are plain files under commands/<category>/<name>.js, loaded at boot
# and hot-reloaded on change — no restart, no registry, no remote fetching.
# 480 previously shipped commands are recoverable from git history:
#   git checkout 16d1f45 -- commands/<path>
# ── Loader protocol ────────────────────────────────────────────────────────
# Set by the auto-sync loader that launches this bot. `.upgrade` refuses to
# exit 44 without it (a bare 44 with nothing to catch it takes the bot down for
# good), and `node_platform` appearing in the working directory also counts.
JUNE_LOADER=
# How long a process command waits for its own reply to land before exiting.
# JUNE_UPGRADE_DELAY_MS=1500
# JUNE_SHUTDOWN_DELAY_MS=2000

# ── Uptime ─────────────────────────────────────────────────────────────────
# Per-bot uptime is persisted, so an .upgrade swap no longer resets it. The
# heartbeat below is the proof-of-life stamp: a session is credited only up to
# the last beat, so downtime after a crash is not counted as uptime. One small
# key per bot, one timer for the whole process. 0 disables the heartbeat (a
# session is then credited up to when the next boot discovers it).
# JUNE_UPTIME_HEARTBEAT_MS=60000

# ── Reconnect ──────────────────────────────────────────────────────────────
# A transient close (428) is retried in 2-6s with jitter; 440/409 keep a hard
# backoff. After 10 consecutive closes a bot moves to a 5-minute slow lane
# instead of giving up, and a watchdog revives any paired bot that is down and
# not retrying. Tuning lives in platform/reconnect.js.

# ── Debug ────────────────────────────────────────────────────────────────
# Verbose per-bot lifecycle logging: connection event dumps, close reasons,
# pairing-code attempts, purge traces. Off = console keeps only the lines
# you act on (connected, pairing code delivered, reconnects, failures).
DEBUG=false

# ── Tiered storage (HOT ram → WARM disk → COLD github) ─────────────────────
# HOT: how many bot stores stay in RAM; idle stores unload (reload = µs)
JUNE_HOT_STORES=25
JUNE_HOT_IDLE_MIN=30
# COLD: private warehouse repo for offline+idle bots (tarballs, git wire
# protocol only — zero REST quota). Leave JUNE_DATA_REPO empty to disable.
JUNE_DATA_REPO=
JUNE_DATA_TOKEN=
JUNE_ARCHIVE_IDLE_DAYS=5
JUNE_HOST_NAME=
# antidelete KV cap per bot per namespace (oldest pruned first)
JUNE_KV_MAX_PER_NS=500

# ── Optional command keys ────────────────────────────────────────────────────
# .telegramsticker / .tgs already ships with a PUBLIC shared token
# (@tokenOne222Bot), so it works with no configuration. Set this only to use
# your own bot instead — any Telegram bot token works for the endpoints used.
TELEGRAM_BOT_TOKEN=
