# JTEST WEB LITE — fully web-based, no JUNE_SESSIONS, no dev dashboard, no mode switch
# Just set PORT and max bots, everything else is managed via web UI at /

PORT=3000
PLATFORM_MAX_BOTS=100
PLATFORM_SLOT_TTL_MIN=15
PLATFORM_CREATES_PER_HOUR=10
PLATFORM_MAX_WS_CONNECTIONS=200
PLATFORM_MAX_WS_PER_IP=20
LOG_LEVEL=silent

# Optional: change log level to info for debugging
# LOG_LEVEL=info
