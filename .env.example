# June X Dashboard Edition
# Copy to .env for local/VPS use. Hosting dashboards may set these directly.

# ── Platform ──────────────────────────────────────────────────────────────────
JUNE_PLATFORM=true
PORT=5000
APP_URL=

# Required to unlock /dev. Use a long, unique password.
ADMIN_PASSWORD=

# One shared dashboard/engine capacity. PLATFORM_MAX_BOTS is canonical.
PLATFORM_MAX_BOTS=30
# Backward-compatible fallback used only when PLATFORM_MAX_BOTS is absent.
JUNE_MAX_SESSIONS=30
PLATFORM_CREATES_PER_HOUR=4
PLATFORM_SLOT_TTL_MIN=15

# Developer login brute-force protection.
PLATFORM_LOGIN_ATTEMPTS=5
PLATFORM_LOGIN_WINDOW_MIN=15
PLATFORM_LOGIN_BLOCK_MIN=15

# WebSocket resource limits.
PLATFORM_MAX_WS_CONNECTIONS=150
PLATFORM_MAX_WS_PER_IP=10
PLATFORM_WS_AUTH_TIMEOUT_SEC=15

# Number of trusted reverse-proxy hops. Known Render/Heroku/Railway environments
# default to one hop. Set 0 for direct local/VPS access without a proxy.
PLATFORM_TRUST_PROXY_HOPS=

# ── Session registry / pairing ────────────────────────────────────────────────
# Dashboard mode supports an intentionally empty fleet.
# Each entry: {"sessionId":"JUNE-X~ab12cd","phone":"2348..."} or {"phone":"2348..."} for pairing-only
# JUNE-X~ handles are minted at https://burning-lorena-eminentbo-ede53cc1.koyeb.app/pair
JUNE_SESSIONS=[]
JUNE_PAIRING_MAX_ATTEMPTS=3
JUNE_PAIRING_STABILIZE_MS=3000
JUNE_SESSIONS_POLL_MS=15000
JUNE_EXPORT_SESSION_TO_ENV=false
JUNE_FORCE_SESSION_BOOTSTRAP=false

# ── Single-bot session (alternative to JUNE_SESSIONS) ────────────────────────
# For single-session deployments, use JUNE-X~ handle (only format accepted)
# Get one at https://burning-lorena-eminentbo-ede53cc1.koyeb.app/pair
SESSION_ID=
# Optional: session server override
JUNE_SESSION_SERVER_URL=

# ── Persistence ───────────────────────────────────────────────────────────────
# PostgreSQL and MongoDB are optional remote mirrors. SQLite remains local.
DATABASE_URL=
MONGODB_URI=
MONGO_URL=

# Optional separate MongoDB registry for web-provisioned session metadata.
# Falls back to MONGODB_URI, then to local data/platform-registry.json.
PLATFORM_MONGODB_URI=
PLATFORM_MONGODB_DB=JuneXPlatform

# Optional local SQLite directory/file overrides.
JUNE_DB_DIR=
JUNE_DB_FILE=

# ── Optional command integrations ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
OPENWEATHER_API_KEY=
