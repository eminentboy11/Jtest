# JTEST WEB LITE — fully web-based, no JUNE_SESSIONS, no dev dashboard
PORT=3000
PLATFORM_MAX_BOTS=100
PLATFORM_SLOT_TTL_MIN=15
PLATFORM_CREATES_PER_HOUR=10
PLATFORM_MAX_WS_CONNECTIONS=200
PLATFORM_MAX_WS_PER_IP=20
LOG_LEVEL=fatal

# ── Storage ──────────────────────────────────────────────────────────────
# There is no database engine. Each bot owns one JSON file:
#   <JUNE_DATA_DIR>/<botId>.json
# Back up by copying the directory. See "Data Storage" in README.md.
# JUNE_DATA_DIR=/path/to/data/bots

# Write debounce per bot, in milliseconds. Writes are atomic (temp + rename),
# so raising this only delays persistence, it does not risk partial files.
# Raise it on slow disks; the exit handler flushes regardless.
# JUNE_DB_FLUSH_MS=250

# ── Commands ─────────────────────────────────────────────────────────────
# Commands are plain files under commands/<category>/<name>.js, loaded at boot
# and hot-reloaded on change — no restart, no registry, no remote fetching.
# 480 previously shipped commands are recoverable from git history:
#   git checkout 16d1f45 -- commands/<path>
# ── Debug ────────────────────────────────────────────────────────────────
# Verbose per-bot lifecycle logging: connection event dumps, close reasons,
# pairing-code attempts, purge traces. Off = console keeps only the lines
# you act on (connected, pairing code delivered, reconnects, failures).
DEBUG=false
