# JTEST WEB LITE — fully web-based, no JUNE_SESSIONS, no dev dashboard
PORT=3000
PLATFORM_MAX_BOTS=100
PLATFORM_SLOT_TTL_MIN=15
PLATFORM_CREATES_PER_HOUR=10
PLATFORM_MAX_WS_CONNECTIONS=200
PLATFORM_MAX_WS_PER_IP=20
LOG_LEVEL=fatal

# ── Mini handler — URL based commands ──
# Option 1: Single JSON URL that returns { "cmdName": "https://.../cmd.js", ... }
# REMOTE_COMMANDS_URL=https://raw.githubusercontent.com/eminentboy11/Jtest/main/data/remote-commands.json

# Option 2: Base URL + list.json — will fetch BASE/list.json → ["sticker","play"] then BASE/sticker.js etc
# REMOTE_COMMANDS_BASE=https://raw.githubusercontent.com/eminentboy11/Jtest/main/examples/commands

# Option 3: Use local file data/remote-commands.json (already exists) — no env needed, just edit file and restart
